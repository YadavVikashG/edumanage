generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
  ACCOUNTANT
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  ONLINE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(STUDENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Teacher {
  id          String        @id @default(cuid())
  employeeNo  String        @unique
  firstName   String
  lastName    String
  email       String        @unique
  phone       String?
  subject     String
  status      StudentStatus @default(ACTIVE)
  classes     SchoolClass[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model SchoolClass {
  id           String             @id @default(cuid())
  name         String
  grade        String
  section      String?
  academicYear String
  feeAmount    Decimal?           @db.Decimal(10, 2)
  teacherId    String?
  teacher      Teacher?           @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  enrollments  Enrollment[]
  attendance   AttendanceRecord[]
  exams        Exam[]
  subjects     ClassSubject[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([name, academicYear])
  @@index([grade, section])
}

model Subject {
  id        String        @id @default(cuid())
  name      String
  grade     String
  classes   ClassSubject[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([name, grade])
  @@index([grade, name])
}

model ClassSubject {
  id        String      @id @default(cuid())
  classId   String
  subjectId String
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([classId, subjectId])
}

model Student {
  id           String        @id @default(cuid())
  admissionNo  String        @unique
  rollNo       String?
  firstName    String
  lastName     String
  email        String        @unique
  phone        String?
  dateOfBirth  DateTime?
  grade        String
  section      String?
  status       StudentStatus  @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  enrollments  Enrollment[]
  attendance   AttendanceRecord[]
  examResults  ExamResult[]
  invoices     FeeInvoice[]

  @@index([lastName, firstName])
  @@index([grade, section])
}

model Enrollment {
  id        String      @id @default(cuid())
  studentId String
  classId   String
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([studentId, classId])
}

model AttendanceRecord {
  id        String           @id @default(cuid())
  studentId String
  classId   String
  date      DateTime         @db.Date
  status    AttendanceStatus
  note      String?
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     SchoolClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, classId, date])
  @@index([date, classId])
}

model Exam {
  id        String       @id @default(cuid())
  name      String
  subject   String
  date      DateTime
  room      String?
  status    ExamStatus   @default(DRAFT)
  classId   String
  class     SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  results   ExamResult[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([date, status])
}

model ExamResult {
  id        String   @id @default(cuid())
  examId    String
  studentId String
  marks     Decimal  @db.Decimal(5, 2)
  grade     String?
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, studentId])
}

model FeeInvoice {
  id          String        @id @default(cuid())
  invoiceNo   String        @unique
  studentId   String
  description String
  amount      Decimal       @db.Decimal(10, 2)
  dueDate     DateTime      @db.Date
  status      InvoiceStatus @default(PENDING)
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments    Payment[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([studentId, status])
}

model Payment {
  id        String        @id @default(cuid())
  receiptNo String      @unique
  invoiceId String
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  paidAt    DateTime      @default(now())
  reference String?
  invoice   FeeInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
}